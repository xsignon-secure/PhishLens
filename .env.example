# Copy to .env and fill in. Never commit the real .env.

# Required: long random string. Generate with:
#   python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# SQLite for dev; Postgres for production, e.g.
#   postgresql+psycopg://user:pass@host:5432/phishlens
DATABASE_URL=sqlite:///./phishlens.db

# Public URL of the app (used in emails; https enables Secure cookies + HSTS)
APP_URL=http://localhost:8000
APP_NAME=PhishLens
JWT_EXPIRE_MINUTES=60
# Comma-separated origins allowed to call the API from browsers (blank = same-origin only)
CORS_ORIGINS=
SCAN_RATE_LIMIT_PER_HOUR=20
# Leave blank for auto (Secure when APP_URL is https)
# COOKIE_SECURE=

# Outbound email (optional; without it alerts stay dashboard-only)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
# true = STARTTLS (587); false = implicit TLS (465)
SMTP_USE_TLS=true

# Contact address shown on your instance's Terms and Privacy pages (optional)
CONTACT_EMAIL=

# Optional abuse brake for a public instance: max monitored domains per team
# (0 = unlimited). Every feature is free; there are no plans or paywalls.
MAX_MONITORS_PER_TEAM=0

# Rescan monitored domains from inside the app every N hours (0 = off).
# 168 = weekly. Replaces an external cron job, e.g. on free hosting.
RESCAN_INTERVAL_HOURS=0

# Rate limits: "memory" for one worker; "database" when running several
# workers or instances, so limits are shared.
RATE_LIMIT_STORAGE=memory

# Check RPKI for mail server routes via RIPEstat (external API; off by default).
RPKI_CHECK=false

# Country of DMARC report senders from a .mmdb file (optional; pip install maxminddb).
GEOIP_DB=

# Optional VirusTotal reputation badge on reports (blank = off; never scored).
# A free VirusTotal account key works (public API, non-commercial use, 4 req/min).
VIRUSTOTAL_API_KEY=
VIRUSTOTAL_RATE_PER_MIN=4
VIRUSTOTAL_CACHE_HOURS=12

# Phishing URL checker on /tools. Domain age comes from RDAP (rdap.org);
# set URL_CHECK_RDAP=false to skip it. The feeds below are off until set.
URL_CHECK_RDAP=true
# Free key: https://developers.google.com/safe-browsing/v4/get-started
SAFE_BROWSING_API_KEY=
# Free key: https://auth.abuse.ch/
URLHAUS_AUTH_KEY=
# OpenPhish community feed (free, refreshed hourly)
OPENPHISH_FEED=false

# Report mailbox for DMARC (rua/ruf) and TLS-RPT reports (optional).
# Point customers' rua= at this address; reports are filed per monitoring tenant.
# Fetched by scripts/fetch_dmarc_reports.py, or by the app itself every
# REPORT_FETCH_MINUTES (0 = off). Configure ONE source:
REPORT_FETCH_MINUTES=0
# IMAP
DMARC_IMAP_HOST=
DMARC_IMAP_USER=
DMARC_IMAP_PASSWORD=
DMARC_IMAP_FOLDER=INBOX
# Microsoft 365 via Graph (app registration with Mail.ReadWrite)
DMARC_GRAPH_TENANT_ID=
DMARC_GRAPH_CLIENT_ID=
DMARC_GRAPH_CLIENT_SECRET=
DMARC_GRAPH_MAILBOX=
# Gmail / Google Workspace via the Gmail API (OAuth refresh token, gmail.modify scope)
DMARC_GMAIL_CLIENT_ID=
DMARC_GMAIL_CLIENT_SECRET=
DMARC_GMAIL_REFRESH_TOKEN=

# Hosted DMARC / SPF / MTA-STS / TLS-RPT / BIMI (optional, see docs/HOSTED-RECORDS.md)
HOSTED_ZONE=
HOSTED_CLOUDFLARE_TOKEN=
HOSTED_CLOUDFLARE_ZONE_ID=
HOSTED_DMARC_RUA=
HOSTED_TLSRPT_RUA=
MTA_STS_TARGET=
RENDER_API_KEY=
RENDER_SERVICE_ID=

# Domain Connect one-click publishing (optional, see docs/DOMAIN-CONNECT.md)
DOMAIN_CONNECT_PROVIDER_ID=
DOMAIN_CONNECT_PROVIDER_NAME=PhishLens
DOMAIN_CONNECT_PRIVATE_KEY=
DOMAIN_CONNECT_KEY_DOMAIN=
DOMAIN_CONNECT_KEY_ID=_dck1
